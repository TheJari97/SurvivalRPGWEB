# SurvivalRPG Web environment variables
# Copy this file to .env.local for local development.
# Do not put real secrets in this example file.

# ---------------------------------------------------------------------------
# Public app settings
# These can be exposed to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=SurvivalRPG
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_DOMAIN=survivalrpgdota.com
NEXT_PUBLIC_SITE_URL=https://survivalrpgdota.com
NEXT_PUBLIC_API_BASE_URL=https://survivalrpgdota.com/api
NEXT_PUBLIC_DEFAULT_LOCALE=auto
NEXT_PUBLIC_SUPPORTED_LOCALES=es,en
NEXT_PUBLIC_RANKINGS_ENABLED=true
NEXT_PUBLIC_STEAM_LOGIN_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_DONATIONS_ENABLED=false

# ---------------------------------------------------------------------------
# Supabase public values
# Public/publishable values are allowed in client code.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://rcymmzxwgyxbyvxxnwbl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_URl7pPamjqovC4caiLHmlg_0X-q0oeG
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_URl7pPamjqovC4caiLHmlg_0X-q0oeG
SUPABASE_PROJECT_REF=rcymmzxwgyxbyvxxnwbl

# ---------------------------------------------------------------------------
# Supabase private/server values
# Only set these in .env.local and Vercel Environment Variables.
# Never expose these to the browser.
# ---------------------------------------------------------------------------
DATABASE_USER=postgres
DATABASE_HOST=db.rcymmzxwgyxbyvxxnwbl.supabase.co
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_SSL_MODE=verify-full
SUPABASE_DB_SSL_CA_PATH=certs/supabase/prod-ca-2021.crt
PGSSLROOTCERT=certs/supabase/prod-ca-2021.crt
DATABASE_POOLER_HOST=
DATABASE_POOLER_PORT=6543
DATABASE_POOLER_URL=
SUPABASE_DB_PASSWORD_RAW=replace_me_in_local_only
SUPABASE_DB_PASSWORD_URL_ENCODED=replace_me_encoded
DATABASE_URL=postgresql://postgres:PASSWORD_URL_ENCODED_WITHOUT_BRACKETS@db.rcymmzxwgyxbyvxxnwbl.supabase.co:5432/postgres?sslmode=verify-full
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_secret_key
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Steam login and profile API
# ---------------------------------------------------------------------------
STEAM_WEB_API_KEY=replace_me
STEAM_OPENID_REALM=https://survivalrpgdota.com
STEAM_OPENID_RETURN_URL=https://survivalrpgdota.com/api/auth/steam/callback

# ---------------------------------------------------------------------------
# Sessions and backend security
# ---------------------------------------------------------------------------
SESSION_SECRET=replace_with_long_random_secret
SRPG_SERVER_API_KEY=replace_with_long_random_secret
SRPG_DOTA_SHARED_SECRET_VERSION=survival_rpg_v1
SRPG_SAVE_ALLOWED_ADDON_VERSION=0.5.9-pre
ADMIN_STEAM_IDS=76561198988350556
INITIAL_ADMIN_USERNAME=JariAdmin
INITIAL_ADMIN_TEMP_PASSWORD=replace_with_local_generated_password
INITIAL_ADMIN_FORCE_PASSWORD_CHANGE=true
AUDIT_RETENTION=indefinite
AUTOSAVE_INTERVAL_MINUTES=10
CURRENT_SEASON_ID=season_001

# ---------------------------------------------------------------------------
# Premium currency and founder settings
# ---------------------------------------------------------------------------
PREMIUM_CURRENCY_ID=titan_shards
PREMIUM_PACKAGES_ENABLED=false
FOUNDER_BADGES_ENABLED=true
ACCOUNT_BANK_PURCHASE_ENABLED=false

# ---------------------------------------------------------------------------
# Payments: choose one active provider first.
# For Peru, start by evaluating PayPal and MercadoPago.
# Stripe stays future/optional unless you operate from a supported country.
# ---------------------------------------------------------------------------
PAYMENTS_PROVIDER=none

# PayPal
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_WEBHOOK_ID=replace_me
PAYPAL_MODE=sandbox

# MercadoPago Peru
MERCADOPAGO_PUBLIC_KEY=replace_me
MERCADOPAGO_ACCESS_TOKEN=replace_me
MERCADOPAGO_WEBHOOK_SECRET=replace_me

# Stripe future/optional
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------------------------
# Optional deployment automation
# Only needed if we automate provider APIs from scripts.
# ---------------------------------------------------------------------------
VERCEL_TOKEN=replace_me_if_needed
VERCEL_PROJECT_ID=replace_me_if_needed
VERCEL_TEAM_ID=replace_me_if_needed
VERCEL_ORG_ID=replace_me_if_needed
CLOUDFLARE_ACCOUNT_ID=replace_me_if_needed
CLOUDFLARE_ZONE_ID=replace_me_if_needed
CLOUDFLARE_API_TOKEN=replace_me_if_needed
